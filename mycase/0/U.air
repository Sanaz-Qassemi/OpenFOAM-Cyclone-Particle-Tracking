FoamFile
{
    format      ascii;
    class       volVectorField;
    location    "0";
    object      U.air;
}

dimensions      [0 1 -1 0 0 0 0];

internalField   uniform (0 0 0);

boundaryField
{
    wall
    {
        type            noSlip;
    }
    dust_dust
    {
        type            pressureInletOutletVelocity;
        phi             phi.air;
        value           uniform (0 0 0);
    }
    inlet
    {
        type            fixedValue;
        value           uniform (19 0 0);
    }
    gas_outlet
    {
        type            zeroGradient;
    }
    body
    {
        type            noSlip;
    }
    default_wall
    {
        type            noSlip;
    }
}
